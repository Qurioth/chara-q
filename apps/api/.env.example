# ローカル開発用の例。`task setup` で .env にコピーされる（.env はコミットしない）
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://chara_q:chara_q@localhost:5432/chara_q?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000

# go test で DB を使うテスト用（未設定ならそのテストはスキップされる）
TEST_DATABASE_URL=postgres://chara_q:chara_q@localhost:5432/chara_q?sslmode=disable
