# ローカル開発用の例。`task setup` で .env にコピーされる（.env はコミットしない）
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://chara_q:chara_q@localhost:5432/chara_q?sslmode=disable

# go test で DB を使うテスト用（未設定ならそのテストはスキップされる）。
# テストは表を空にするため、開発用の DB とは別のデータベースにする（task db:test:prepare で作る）
TEST_DATABASE_URL=postgres://chara_q:chara_q@localhost:5432/chara_q_test?sslmode=disable
